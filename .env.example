# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=

# Vercel Postgres — created via Vercel Storage tab, pulled with `vercel env pull`
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob — created via Vercel Storage tab, pulled with `vercel env pull`
BLOB_READ_WRITE_TOKEN=

# Resend — create at resend.com, API Keys → Create API Key (Sending access)
RESEND_API_KEY=
